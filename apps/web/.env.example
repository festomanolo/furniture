# Base URL of the SAMANI Fastify API (e.g. https://api.samani.co.tz/api/v1).
# Leave empty in development to run against the in-browser demo catalogue (seed data).
VITE_API_URL=
# Public CDN origin serving processed R2 image derivatives (no credentials here, ever).
VITE_MEDIA_CDN_URL=
# WhatsApp support number in international format without "+", e.g. 255712000000
VITE_SUPPORT_WHATSAPP=
